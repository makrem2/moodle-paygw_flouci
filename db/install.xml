<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="payment/gateway/flouci/db" VERSION="20261003" COMMENT="XMLDB file for the Flouci payment gateway plugin"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="paygw_flouci" COMMENT="Flouci payment sessions and their state">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ref" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Random reference generated by Moodle, sent to Flouci as developer_tracking_id"/>
        <FIELD NAME="flouciid" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="payment_id returned by Flouci (empty until the session is created)"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="paymentarea" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="accountid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="amountmillimes" TYPE="int" LENGTH="12" NOTNULL="true" SEQUENCE="false" COMMENT="Amount the server asked Flouci to charge, in millimes (1 TND = 1000)"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" DEFAULT="TND" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, paid, complete, failed, expired or mismatch"/>
        <FIELD NAME="paymentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="payments.id once the payment is confirmed"/>
        <FIELD NAME="checkouturl" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Flouci checkout URL, reused if the user clicks pay twice"/>
        <FIELD NAME="returnurl" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Local page to send the user back to when the payment does not succeed"/>
        <FIELD NAME="lasterror" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="ref" TYPE="unique" FIELDS="ref"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="accountid" TYPE="foreign" FIELDS="accountid" REFTABLE="payment_accounts" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="flouciid" UNIQUE="false" FIELDS="flouciid"/>
        <INDEX NAME="status-timecreated" UNIQUE="false" FIELDS="status, timecreated"/>
        <INDEX NAME="paymentid" UNIQUE="false" FIELDS="paymentid"/>
        <INDEX NAME="item" UNIQUE="false" FIELDS="userid, component, paymentarea, itemid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
